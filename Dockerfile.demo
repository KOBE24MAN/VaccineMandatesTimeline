FROM node:20-alpine AS frontend-build

WORKDIR /build/frontend
COPY frontend_client/package.json frontend_client/package-lock.json ./
RUN npm ci
COPY frontend_client/ ./
RUN npm run build

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    LOG_LEVEL=INFO \
    PORT=8000 \
    STATIC_DIR=/app/static \
    DATABASE_URL=sqlite:///file:/app/data/mandates.db?mode=ro&uri=true \
    ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY requirements-demo.txt ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-demo.txt

COPY app ./app
COPY main.py ./main.py
COPY data/release/mandates.db ./data/mandates.db
COPY --from=frontend-build /build/frontend/dist ./static

RUN chmod 0444 /app/data/mandates.db && chown -R app:app /app/static
USER app

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=4 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)"

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
