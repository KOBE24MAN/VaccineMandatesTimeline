FROM node:20-alpine AS frontend-build

WORKDIR /build/frontend
COPY frontend_client/package.json frontend_client/package-lock.json ./
RUN npm ci
COPY frontend_client/ ./
RUN npm run build

FROM node:20-alpine AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    LOG_LEVEL=INFO \
    PORT=8000 \
    STATIC_DIR=/app/static \
    DATABASE_URL=sqlite:///file:/app/data/mandates.db?mode=ro&uri=true \
    ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

WORKDIR /app

RUN for attempt in 1 2 3; do \
        apk add --no-cache python3 py3-pip && break; \
        if [ "$attempt" -eq 3 ]; then exit 1; fi; \
        sleep 3; \
    done \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && addgroup -S app \
    && adduser -S -D -H -G app app

COPY requirements-demo.txt ./
RUN pip install \
        --break-system-packages \
        --no-cache-dir \
        --disable-pip-version-check \
        --retries 5 \
        --timeout 60 \
        -r requirements-demo.txt \
    && rm -rf /usr/local/lib/node_modules \
    && rm -f /usr/local/bin/node /usr/local/bin/npm /usr/local/bin/npx

COPY app ./app
COPY main.py ./main.py
COPY data/release/mandates.db ./data/mandates.db
COPY --from=frontend-build /build/frontend/dist ./static

RUN chmod 0444 /app/data/mandates.db && chown -R app:app /app/static
USER app

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=4 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)"

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
